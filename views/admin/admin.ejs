<%- include('../partials/head', { title: 'Admin Dashboard' }) %>
</head>
<body class="bg-slate-100">

  <!-- Navbar -->
  <nav class="bg-white shadow-md px-4 sm:px-10 py-4 flex flex-wrap gap-3 justify-between items-center">
    <a href="/" class="flex items-center gap-3">
      <img src="https://upload.wikimedia.org/wikipedia/en/thumb/2/24/National_Institute_of_Technology%2C_Srinagar_Logo.png/250px-National_Institute_of_Technology%2C_Srinagar_Logo.png" alt="NIT Srinagar" class="h-10 w-auto">
      <span class="text-xl font-bold text-blue-600">
        NIT Srinagar Helpdesk
      </span>
    </a>

    <div class="flex flex-wrap items-center gap-3 sm:gap-6">
      <a href="/admin/notifications" class="text-blue-600 font-medium hover:underline">
        Notifications
        <% if (notificationSummary?.unreadCount > 0) { %>
          <span class="ml-1 rounded-full bg-red-500 px-2 py-0.5 text-xs text-white"><%= notificationSummary.unreadCount %></span>
        <% } %>
      </a>
      <span class="text-gray-700 font-medium">
        Welcome, <%= user.username %>
      </span>
      
      <form action="/admin-logout" method="POST" class="inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit"
         class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition">
        Logout
      </button>
      </form>
    </div>
  </nav>

  <!-- Main Container -->
  <main class="px-4 sm:px-6 lg:px-10 py-6 sm:py-8">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-end gap-2 mb-8">
      <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-600">Department workspace</p>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-800">
        Admin Dashboard
      </h1>
      </div>
      <p class="text-sm text-gray-500">Statistics cover all tickets in your department.</p>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5 mb-10">
      <div class="bg-white p-4 sm:p-6 rounded-xl shadow-sm border-l-4 border-slate-400">
        <p class="text-xs sm:text-sm font-medium text-gray-500">Total Tickets</p>
        <h2 class="mt-2 text-2xl sm:text-3xl font-bold text-gray-800"><%= totalTickets %></h2>
      </div>

      <div class="bg-white p-4 sm:p-6 rounded-xl shadow-sm border-l-4 border-red-400">
        <p class="text-xs sm:text-sm font-medium text-gray-500">Open</p>
        <h2 class="mt-2 text-2xl sm:text-3xl font-bold text-red-500"><%= openTickets %></h2>
      </div>

      <div class="bg-white p-4 sm:p-6 rounded-xl shadow-sm border-l-4 border-yellow-400">
        <p class="text-xs sm:text-sm font-medium text-gray-500">In Progress</p>
        <h2 class="mt-2 text-2xl sm:text-3xl font-bold text-yellow-500"><%= inProgressTickets %></h2>
      </div>

      <div class="bg-white p-4 sm:p-6 rounded-xl shadow-sm border-l-4 border-green-500">
        <p class="text-xs sm:text-sm font-medium text-gray-500">Resolved</p>
        <h2 class="mt-2 text-2xl sm:text-3xl font-bold text-green-600"><%= resolvedTickets %></h2>
      </div>
    </div>

    <!-- Filters -->
    <form action="/admin" method="GET" class="bg-white rounded-xl shadow-sm p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[auto_auto_1fr_auto] gap-3 items-end mb-6">

  <label class="text-sm font-medium text-gray-700">Status
  <select
    name="status"
    data-submit-form-on-change
    aria-label="Filter by status"
    class="mt-1 w-full px-4 py-2 rounded-lg border border-gray-300 bg-white"
  >

    <option value="All"
      <%= statusFilter === "All" ? "selected" : "" %>>
      All
    </option>

    <option value="Open"
      <%= statusFilter === "Open" ? "selected" : "" %>>
      Open
    </option>

    <option value="In Progress"
      <%= statusFilter === "In Progress" ? "selected" : "" %>>
      In Progress
    </option>

    <option value="Resolved"
      <%= statusFilter === "Resolved" ? "selected" : "" %>>
      Resolved
    </option>

  </select>
  </label>
  <label class="text-sm font-medium text-gray-700">Priority
  <select
    name="priority"
    data-submit-form-on-change
    aria-label="Filter by priority"
    class="mt-1 w-full px-4 py-2 rounded-lg border border-gray-300 bg-white"
  >
    <option value="All" <%= priorityFilter === "All" ? "selected" : "" %>>
      All priorities
    </option>
    <option value="Low" <%= priorityFilter === "Low" ? "selected" : "" %>>Low</option>
    <option value="Medium" <%= priorityFilter === "Medium" ? "selected" : "" %>>Medium</option>
    <option value="High" <%= priorityFilter === "High" ? "selected" : "" %>>High</option>
    <option value="Urgent" <%= priorityFilter === "Urgent" ? "selected" : "" %>>Urgent</option>
  </select>
  </label>
  <label class="text-sm font-medium text-gray-700">Search
  <input 
  type="text" 
  name="search"
  value="<%= search %>"
  placeholder="Search by title or student..."
  class="mt-1 px-4 py-2 rounded-lg border border-gray-300 w-full"
/>
  </label>

<button
  type="submit"
  class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 font-medium"
>
  Search
</button>
</form>

    <!-- Ticket Table -->
    <div class="bg-white rounded-xl shadow overflow-hidden">
      <div class="overflow-x-auto">
      <table class="w-full min-w-[900px] text-left">
        <thead class="bg-slate-100">
          <tr>
            <th class="px-4 sm:px-6 py-3 text-xs uppercase tracking-wide text-gray-500">Reference</th>
            <th class="px-4 sm:px-6 py-3 text-xs uppercase tracking-wide text-gray-500">Title</th>
            <th class="px-4 sm:px-6 py-3 text-xs uppercase tracking-wide text-gray-500">Student</th>
            <th class="px-4 sm:px-6 py-3 text-xs uppercase tracking-wide text-gray-500">Category</th>
            <th class="px-4 sm:px-6 py-3 text-xs uppercase tracking-wide text-gray-500">Priority</th>
            <th class="px-4 sm:px-6 py-3 text-xs uppercase tracking-wide text-gray-500">Status</th>
            <th class="px-4 sm:px-6 py-3 text-xs uppercase tracking-wide text-gray-500">Actions</th>
          </tr>
        </thead>
       <tbody>

    <% if (tickets.length === 0) { %>
      <tr>
        <td colspan="7" class="text-center py-10 text-gray-500">
          No tickets found.
        </td>
      </tr>
    <% } %>

    <% tickets.forEach(ticket => { %>

    <tr class="border-t hover:bg-slate-50">

      <td class="px-4 sm:px-6 py-3">
        <span class="font-mono font-semibold text-gray-700" title="Full ticket ID: <%= ticket._id %>">
          TKT-<%= String(ticket._id).slice(-8).toUpperCase() %>
        </span>
        <details class="mt-1 text-xs text-gray-500">
          <summary class="cursor-pointer hover:text-blue-600">Show full ID</summary>
          <code class="break-all"><%= ticket._id %></code>
        </details>
      </td>

      <td class="px-4 sm:px-6 py-3 max-w-xs break-words">
        <a href="/admin/ticket/<%= ticket._id %>" class="text-blue-600 hover:underline break-words">
          <%= ticket.title %>
        </a>
      </td>

      <td class="px-4 sm:px-6 py-3">
        <%= ticket.student.username %>
      </td>

      <td class="px-4 sm:px-6 py-3">
        <%= ticket.category %>
      </td>

      <td class="px-4 sm:px-6 py-3">
        <% const priority = ticket.priority || "Medium"; %>
        <% if (priority === "Urgent") { %>
          <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-sm font-semibold">
            Urgent
          </span>
        <% } else if (priority === "High") { %>
          <span class="bg-red-50 text-red-600 px-3 py-1 rounded-full text-sm">
            High
          </span>
        <% } else if (priority === "Low") { %>
          <span class="bg-green-100 text-green-600 px-3 py-1 rounded-full text-sm">
            Low
          </span>
        <% } else { %>
          <span class="bg-yellow-100 text-yellow-600 px-3 py-1 rounded-full text-sm">
            Medium
          </span>
        <% } %>
      </td>

      <td class="px-4 sm:px-6 py-3">

        <span class="
          px-3 py-1 rounded-full text-sm

          <%= ticket.status === 'Open'
            ? 'bg-red-100 text-red-600'
            : ticket.status === 'In Progress'
            ? 'bg-yellow-100 text-yellow-600'
            : 'bg-green-100 text-green-600'
          %>
        ">

          <%= ticket.status %>

        </span>

      </td>

      <td class="px-4 sm:px-6 py-3 space-y-2">
        <span class="block text-xs font-semibold uppercase tracking-wide text-gray-500">Priority</span>

        <form
          action="/update-priority/<%= ticket._id %>"
          method="POST"
          data-update-form
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <select
            name="priority"
            data-submit-form-on-change
            aria-label="Update priority for <%= ticket.title %>"
            class="w-full px-2 py-1 border border-gray-300 rounded bg-white"
          >
            <% const selectedPriority = ticket.priority || "Medium"; %>
            <option value="Low" <%= selectedPriority === "Low" ? "selected" : "" %>>Low</option>
            <option value="Medium" <%= selectedPriority === "Medium" ? "selected" : "" %>>Medium</option>
            <option value="High" <%= selectedPriority === "High" ? "selected" : "" %>>High</option>
            <option value="Urgent" <%= selectedPriority === "Urgent" ? "selected" : "" %>>Urgent</option>
          </select>
        </form>

        <span class="block text-xs font-semibold uppercase tracking-wide text-gray-500">Status</span>
        <form
          action="/update-status/<%= ticket._id %>"
          method="POST"
          data-update-form
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="resolutionDetails" value="">

          <select
            name="status"
            data-submit-form-on-change
            data-ticket-status-select
            data-ticket-title="<%= ticket.title %>"
            aria-label="Update status for <%= ticket.title %>"
            class="w-full px-2 py-1 border border-gray-300 rounded bg-white"
          >

            <option
              value="Open"
              <%= ticket.status === "Open" ? "selected" : "" %>>
              Open
            </option>

            <option
              value="In Progress"
              <%= ticket.status === "In Progress" ? "selected" : "" %>>
              In Progress
            </option>

            <option
              value="Resolved"
              <%= ticket.status === "Resolved" ? "selected" : "" %>>
              Resolved
            </option>

          </select>

        </form>
        <span class="block text-xs font-semibold uppercase tracking-wide text-gray-500">Ticket</span>
        <a href="/admin/ticket/<%= ticket._id %>" class="block text-center rounded-md bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-700">
          View Details / Comment
        </a>

      </td>

    </tr>

  <% }) %>

</tbody>
      </table>
    </div>

    <% const paginationQuery = new URLSearchParams({
      status: statusFilter,
      priority: priorityFilter,
      search,
    }); %>
    <% const paginationStart = Math.max(1, page - 2); %>
    <% const paginationEnd = Math.min(totalPages, page + 2); %>
    <nav class="flex flex-wrap items-center justify-center gap-2 mt-6" aria-label="Ticket pages">
      <% if (page > 1) { %>
        <a href="/admin?<%= paginationQuery.toString() %>&page=<%= page - 1 %>" class="px-3 py-2 rounded border bg-white text-blue-600 hover:bg-blue-50">Previous</a>
      <% } else { %>
        <span class="px-3 py-2 rounded border text-gray-400 bg-gray-100">Previous</span>
      <% } %>

      <% if (paginationStart > 1) { %>
        <a href="/admin?<%= paginationQuery.toString() %>&page=1" class="px-3 py-2 rounded border bg-white text-blue-600 hover:bg-blue-50">1</a>
        <% if (paginationStart > 2) { %><span class="px-1 text-gray-500">...</span><% } %>
      <% } %>

      <% for (let pageNumber = paginationStart; pageNumber <= paginationEnd; pageNumber++) { %>
        <% if (pageNumber === page) { %>
          <span aria-current="page" class="px-3 py-2 rounded border border-blue-600 bg-blue-600 text-white"><%= pageNumber %></span>
        <% } else { %>
          <a href="/admin?<%= paginationQuery.toString() %>&page=<%= pageNumber %>" class="px-3 py-2 rounded border bg-white text-blue-600 hover:bg-blue-50"><%= pageNumber %></a>
        <% } %>
      <% } %>

      <% if (paginationEnd < totalPages) { %>
        <% if (paginationEnd < totalPages - 1) { %><span class="px-1 text-gray-500">...</span><% } %>
        <a href="/admin?<%= paginationQuery.toString() %>&page=<%= totalPages %>" class="px-3 py-2 rounded border bg-white text-blue-600 hover:bg-blue-50"><%= totalPages %></a>
      <% } %>

      <% if (page < totalPages) { %>
        <a href="/admin?<%= paginationQuery.toString() %>&page=<%= page + 1 %>" class="px-3 py-2 rounded border bg-white text-blue-600 hover:bg-blue-50">Next</a>
      <% } else { %>
        <span class="px-3 py-2 rounded border text-gray-400 bg-gray-100">Next</span>
      <% } %>
    </nav>

    </div>
  </main>

  <dialog id="resolution-dialog" aria-labelledby="resolution-dialog-title" class="rounded-xl p-0 shadow-xl backdrop:bg-slate-900/50">
    <form method="dialog" class="w-[min(90vw,32rem)] bg-white p-6">
      <h2 id="resolution-dialog-title" class="text-xl font-semibold text-gray-800">Resolve Ticket</h2>
      <p id="resolution-ticket-title" class="mt-2 text-sm text-gray-600"></p>
      <label for="resolution-details" class="mt-4 block text-sm font-medium text-gray-700">Resolution Details</label>
      <textarea id="resolution-details" rows="5" maxlength="2000" required class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2" placeholder="Explain how the complaint was resolved"></textarea>
      <p id="resolution-error" class="mt-2 text-sm text-red-600" role="alert" hidden></p>
      <div class="mt-5 flex justify-end gap-3">
        <button type="button" data-resolution-cancel class="rounded-md border border-gray-300 px-4 py-2 text-gray-700">Cancel</button>
        <button type="button" data-resolution-confirm class="rounded-md bg-green-600 px-4 py-2 text-white hover:bg-green-700">Resolve Ticket</button>
      </div>
    </form>
  </dialog>

<script src="/js/admin-dashboard.js?v=resolution-dialog-1"></script>
</body>
</html>
