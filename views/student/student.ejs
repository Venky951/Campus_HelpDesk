<%- include('../partials/head', { title: 'Student Dashboard' }) %>
</head>
<body class="bg-slate-100">

  <!-- Navbar -->
<%- include('../partials/nav') %> 
  <!-- Main Container -->
  <div class="px-10 py-8">

    <!-- Top Actions -->
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold text-gray-800">
        Student Dashboard
      </h1>

      <a href="/raiseticket"
         class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition">
        + Raise New Ticket
      </a>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      <div class="bg-white p-6 rounded-xl shadow">
        <p class="text-gray-500">Total Tickets</p>
        <h2 class="text-3xl font-bold">5</h2>
      </div>

      <div class="bg-white p-6 rounded-xl shadow">
        <p class="text-gray-500">Open</p>
        <h2 class="text-3xl font-bold text-red-500">2</h2>
      </div>

      <div class="bg-white p-6 rounded-xl shadow">
        <p class="text-gray-500">Resolved</p>
        <h2 class="text-3xl font-bold text-green-600">3</h2>
      </div>
    </div>

    <!-- Ticket List -->
    <div class="bg-white rounded-xl shadow overflow-hidden">
      <div class="px-6 py-4 border-b">
        <h2 class="text-xl font-semibold">My Tickets</h2>
      </div>

      <table class="w-full text-left">
        <thead class="bg-slate-100">
          <tr>
            <th class="px-6 py-3">ID</th>
            <th class="px-6 py-3">Title</th>
            <th class="px-6 py-3">Category</th>
            <th class="px-6 py-3">Status</th>
            <th class="px-6 py-3">Created</th>
          </tr>
        </thead>
        <tbody>

          <!-- Example Row -->
          <tr class="border-t hover:bg-slate-50">
            <td class="px-6 py-3">#101</td>
            <td class="px-6 py-3">WiFi not working</td>
            <td class="px-6 py-3">IT</td>
            <td class="px-6 py-3">
              <span class="bg-red-100 text-red-600 px-3 py-1 rounded-full text-sm">
                Open
              </span>
            </td>
            <td class="px-6 py-3">01 Feb 2026</td>
          </tr>

          <tr class="border-t hover:bg-slate-50">
            <td class="px-6 py-3">#102</td>
            <td class="px-6 py-3">Hostel water issue</td>
            <td class="px-6 py-3">Hostel</td>
            <td class="px-6 py-3">
              <span class="bg-green-100 text-green-600 px-3 py-1 rounded-full text-sm">
                Resolved
              </span>
            </td>
            <td class="px-6 py-3">28 Jan 2026</td>
          </tr>

        </tbody>
      </table>
    </div>

    <!-- Empty State (use when no tickets) -->
    <!--
    <div class="text-center mt-20">
      <p class="text-gray-600 mb-4">
        You have not raised any tickets yet.
      </p>
      <a href="/raise-ticket"
         class="bg-blue-600 text-white px-6 py-3 rounded-lg">
        Raise your first ticket
      </a>
    </div>
    -->

  </div>

</body>
</html>
