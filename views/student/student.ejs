<%- include('../partials/head', { title: 'Student Dashboard' }) %>
</head>
<body class="bg-slate-100">

  <!-- Navbar -->
<%- include('../partials/nav') %> 
  <!-- Main Container -->
  <div class="px-4 sm:px-10 py-6 sm:py-8">

    <!-- Top Actions -->
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-800">
        Student Dashboard
      </h1>

      <a href="/student/raiseticket"
         class="w-full sm:w-auto text-center bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition">
        + Raise New Ticket
      </a>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      <div class="bg-white p-6 rounded-xl shadow">
        <p class="text-gray-500">Total Tickets</p>
        <h2 class="text-3xl font-bold"><%= totalTickets %></h2>
      </div>

      <div class="bg-white p-6 rounded-xl shadow">
        <p class="text-gray-500">Open</p>
        <h2 class="text-3xl font-bold text-red-500"><%= openTickets %></h2>
      </div>

      <div class="bg-white p-6 rounded-xl shadow">
        <p class="text-gray-500">Resolved</p>
        <h2 class="text-3xl font-bold text-green-600"><%= resolvedTickets %></h2>
      </div>
    </div>

    <!-- Ticket List -->
    <div class="bg-white rounded-xl shadow overflow-hidden">
      <div class="px-6 py-4 border-b">
        <h2 class="text-xl font-semibold">My Tickets</h2>
      </div>

      <div class="overflow-x-auto">
      <table class="w-full min-w-[640px] text-left">
        <thead class="bg-slate-100">
          <tr>
            <th class="px-6 py-3">ID</th>
            <th class="px-6 py-3">Title</th>
            <th class="px-6 py-3">Priority</th>
            <th class="px-6 py-3">Category</th>
            <th class="px-6 py-3">Status</th>
            <th class="px-6 py-3">Created</th>
          </tr>
        </thead>
<tbody>

  <% if (tickets.length > 0) { %>

    <% tickets.forEach((ticket, index) => { %>

      <tr class="border-t hover:bg-slate-50">

        <td class="px-6 py-3">
          #<%= index + 1 %>
        </td>

        <td class="px-6 py-3 max-w-xs break-words">
          <a href="/student/ticket/<%= ticket._id %>" class="text-blue-600 hover:underline break-words">
            <%= ticket.title %>
          </a>
        </td>

        <td class="px-6 py-3">
          <% const priority = ticket.priority || "Medium"; %>
          <% if (priority === "Urgent") { %>
            <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-sm font-semibold">
              Urgent
            </span>
          <% } else if (priority === "High") { %>
            <span class="bg-red-50 text-red-600 px-3 py-1 rounded-full text-sm">
              High
            </span>
          <% } else if (priority === "Low") { %>
            <span class="bg-green-100 text-green-600 px-3 py-1 rounded-full text-sm">
              Low
            </span>
          <% } else { %>
            <span class="bg-yellow-100 text-yellow-600 px-3 py-1 rounded-full text-sm">
              Medium
            </span>
          <% } %>
        </td>

        <td class="px-6 py-3">
          <%= ticket.category %>
        </td>

        <td class="px-6 py-3">

          <% if(ticket.status === "Open") { %>

            <span class="bg-red-100 text-red-600 px-3 py-1 rounded-full text-sm">
              Open
            </span>

          <% } else if(ticket.status === "In Progress") { %>

            <span class="bg-yellow-100 text-yellow-600 px-3 py-1 rounded-full text-sm">
              In Progress
            </span>

          <% } else { %>

            <span class="bg-green-100 text-green-600 px-3 py-1 rounded-full text-sm">
              Resolved
            </span>

          <% } %>

        </td>

        <td class="px-6 py-3">
          <%= new Date(ticket.createdAt).toLocaleDateString() %>
        </td>

      </tr>

    <% }) %>

  <% } else { %>

    <tr>
      <td colspan="6" class="text-center py-10 text-gray-500">
        No tickets raised yet.
      </td>
    </tr>

  <% } %>

</tbody>
      </table>
      </div>
    </div>

    <!-- Empty State (use when no tickets) -->
    <!--
    <div class="text-center mt-20">
      <p class="text-gray-600 mb-4">
        You have not raised any tickets yet.
      </p>
      <a href="/raise-ticket"
         class="bg-blue-600 text-white px-6 py-3 rounded-lg">
        Raise your first ticket
      </a>
    </div>
    -->

  </div>

</body>
</html>
