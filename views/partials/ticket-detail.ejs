<body class="bg-slate-100">
  <%- include(navPartial) %>

  <main class="px-4 sm:px-10 py-6 sm:py-8">
    <div class="max-w-5xl mx-auto space-y-6">
      <a href="<%= backUrl %>" class="inline-flex items-center text-blue-600 font-medium hover:underline">&larr; Back to dashboard</a>

      <section class="bg-white rounded-xl shadow p-5 sm:p-8">
        <div class="flex flex-col sm:flex-row sm:justify-between gap-4 mb-6">
          <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-blue-600">Ticket details</p>
            <h1 class="text-2xl sm:text-3xl font-bold text-gray-800 break-words"><%= ticket.title %></h1>
            <p class="mt-2 font-mono text-sm text-gray-500">TKT-<%= String(ticket._id).slice(-8).toUpperCase() %></p>
            <details class="mt-1 text-xs text-gray-500">
              <summary class="cursor-pointer hover:text-blue-600">Show full ticket ID</summary>
              <code class="break-all"><%= ticket._id %></code>
            </details>
          </div>
          <div class="text-sm text-gray-500 sm:text-right">
            Created <%= new Date(ticket.createdAt).toLocaleString() %>
          </div>
        </div>

        <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
          <div class="rounded-lg bg-slate-50 p-4">
            <dt class="text-sm text-gray-500">Category</dt>
            <dd class="font-medium break-words"><%= ticket.category %></dd>
          </div>
          <div class="rounded-lg bg-slate-50 p-4">
            <dt class="text-sm text-gray-500">Status</dt>
            <dd class="font-medium"><%= ticket.status %></dd>
          </div>
          <div class="rounded-lg bg-slate-50 p-4">
            <dt class="text-sm text-gray-500">Priority</dt>
            <dd class="font-medium"><%= ticket.priority || "Medium" %></dd>
          </div>
          <div class="rounded-lg bg-slate-50 p-4">
            <dt class="text-sm text-gray-500">Assigned administrator</dt>
            <dd class="font-medium break-words"><%= ticket.assignedTo?.username || "Unassigned" %></dd>
          </div>
        </dl>

        <div class="border-t pt-5">
          <h2 class="text-lg font-semibold mb-2">Description</h2>
          <p class="text-gray-700 whitespace-pre-wrap break-words"><%= ticket.description %></p>
        </div>
        <% if (resolutionEvent) { %>
          <div class="border-l-4 border-green-500 bg-green-50 mt-5 p-5 rounded-r-lg">
            <h2 class="text-lg font-semibold mb-2 text-green-900">Resolution Details</h2>
            <p class="text-gray-700 whitespace-pre-wrap break-words"><%= resolutionEvent.details.resolutionDetails %></p>
            <p class="mt-2 text-sm text-green-800">
              Resolved by <%= resolutionEvent.actor?.username || "Admin" %>
              on <%= new Date(resolutionEvent.createdAt).toLocaleString() %>
            </p>
          </div>
        <% } %>
        <% if (ticket.reopenCount > 0) { %>
          <div class="mt-5 rounded-lg border border-amber-200 bg-amber-50 p-4">
            <h2 class="font-semibold text-amber-900">Reopened ticket</h2>
            <p class="mt-1 text-sm text-amber-800">
              Reopened <%= ticket.reopenCount %> time<%= ticket.reopenCount === 1 ? "" : "s" %>.
              <% if (ticket.lastReopenedAt) { %>
                Last reopened <%= new Date(ticket.lastReopenedAt).toLocaleString() %>.
              <% } %>
            </p>
          </div>
        <% } %>
        <% if (user.role === "admin" && (ticket.resolutionConfirmedAt || ticket.feedbackSubmittedAt)) { %>
          <div class="mt-5 rounded-lg border border-blue-200 bg-blue-50 p-5">
            <h2 class="text-lg font-semibold text-blue-900">Student feedback</h2>
            <% if (ticket.resolutionConfirmedAt) { %>
              <p class="mt-1 text-sm text-blue-800">Resolution confirmed <%= new Date(ticket.resolutionConfirmedAt).toLocaleString() %>.</p>
            <% } %>
            <% if (ticket.feedbackSubmittedAt) { %>
              <p class="mt-2 text-sm text-gray-700">Rating: <%= ticket.feedbackRating %> / 5</p>
              <% if (ticket.feedbackComment) { %>
                <p class="mt-1 whitespace-pre-wrap text-sm text-gray-700"><%= ticket.feedbackComment %></p>
              <% } %>
            <% } %>
          </div>
        <% } %>
        <% if (user.role === "student" && ticket.status === "Resolved") { %>
          <section class="mt-5 rounded-lg border border-green-200 bg-green-50 p-5">
            <% if (!ticket.resolutionConfirmedAt) { %>
              <h2 class="text-lg font-semibold text-green-900">Is this issue resolved?</h2>
              <p class="mt-1 text-sm text-green-800">Confirm the resolution or reopen the ticket if the problem persists.</p>
              <div class="mt-4 flex flex-col gap-4">
                <form action="/student/ticket/<%= ticket._id %>/confirm-resolution" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="w-full rounded-md bg-green-700 px-4 py-2 text-white hover:bg-green-800 sm:w-auto">Confirm Resolution</button>
                </form>
                <form action="/student/ticket/<%= ticket._id %>/reopen" method="POST" class="space-y-2">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <label for="reopen-reason" class="block text-sm font-medium text-amber-900">Why does this ticket need to be reopened?</label>
                  <textarea id="reopen-reason" name="reason" rows="3" maxlength="2000" required class="block w-full rounded-md border border-amber-300 px-3 py-2" placeholder="Explain what is still unresolved"></textarea>
                  <button type="submit" class="rounded-md bg-amber-600 px-4 py-2 text-white hover:bg-amber-700">Reopen Ticket</button>
                </form>
              </div>
            <% } else { %>
              <h2 class="text-lg font-semibold text-green-900">Resolution confirmed</h2>
              <p class="mt-1 text-sm text-green-800">Confirmed <%= new Date(ticket.resolutionConfirmedAt).toLocaleString() %>.</p>
              <% if (!ticket.feedbackSubmittedAt) { %>
                <form action="/student/ticket/<%= ticket._id %>/feedback" method="POST" class="mt-4 space-y-3">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <label for="feedback-rating" class="block text-sm font-medium text-gray-700">Rate this resolution</label>
                  <select id="feedback-rating" name="feedbackRating" required class="rounded-md border border-gray-300 px-3 py-2">
                    <option value="">Choose a rating</option>
                    <% [1, 2, 3, 4, 5].forEach((rating) => { %>
                      <option value="<%= rating %>"><%= rating %> / 5</option>
                    <% }) %>
                  </select>
                  <label for="feedback-comment" class="block text-sm font-medium text-gray-700">Feedback comment (optional)</label>
                  <textarea id="feedback-comment" name="feedbackComment" rows="3" maxlength="2000" class="block w-full rounded-md border border-gray-300 px-3 py-2" placeholder="Share feedback about the resolution"></textarea>
                  <button type="submit" class="rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700">Submit Feedback</button>
                </form>
              <% } else { %>
                <p class="mt-3 font-medium text-green-900">Thank you for your feedback.</p>
                <p class="mt-1 text-sm text-gray-700">Rating: <%= ticket.feedbackRating %> / 5</p>
                <% if (ticket.feedbackComment) { %>
                  <p class="mt-1 whitespace-pre-wrap text-sm text-gray-700"><%= ticket.feedbackComment %></p>
                <% } %>
              <% } %>
            <% } %>
          </section>
        <% } %>
        <% if (ticket.attachment?.fileId) { %>
          <div class="border-t mt-5 pt-5">
            <h2 class="text-lg font-semibold mb-2">Attachment</h2>
            <a href="<%= backUrl %>/ticket/<%= ticket._id %>/attachment" class="text-blue-600 hover:underline break-all">
              Download <%= ticket.attachment.filename %>
            </a>
          </div>
        <% } %>
      </section>

      <section class="bg-white rounded-xl shadow-sm p-5 sm:p-8">
        <div class="flex items-center justify-between gap-3 mb-5">
          <h2 class="text-xl font-semibold">Conversation</h2>
          <a href="#reply" class="text-sm font-medium text-blue-600 hover:underline">Add reply</a>
        </div>

        <% if (comments.length === 0) { %>
          <p class="text-gray-500">No replies yet.</p>
        <% } else { %>
          <div class="space-y-4">
            <% comments.forEach((comment) => { %>
              <article class="border rounded-lg p-4 <%= comment.authorRole === 'admin' ? 'bg-blue-50 border-blue-100' : 'bg-gray-50 border-gray-200' %>">
                <div class="flex flex-col sm:flex-row sm:justify-between gap-1 mb-2">
                  <strong class="text-gray-800"><%= comment.authorRole === "admin" ? "Admin" : "Student" %> · <%= comment.author?.username || "User" %></strong>
                  <time class="text-sm text-gray-500"><%= new Date(comment.createdAt).toLocaleString() %></time>
                </div>
                <p class="text-gray-700 whitespace-pre-wrap break-words"><%= comment.message %></p>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section class="bg-white rounded-xl shadow-sm p-5 sm:p-8">
        <h2 class="text-xl font-semibold mb-5">Ticket History</h2>

        <% if (history.length === 0) { %>
          <p class="text-gray-500">No history available for this ticket.</p>
        <% } else { %>
          <ol class="space-y-4 border-l-2 border-blue-100 pl-5">
            <% history.forEach((event) => { %>
              <li class="relative">
                <span class="absolute -left-[1.65rem] top-1 h-3 w-3 rounded-full bg-blue-600"></span>
                <time class="text-sm text-gray-500"><%= new Date(event.createdAt).toLocaleString() %></time>
                <p class="font-medium text-gray-800">
                  <%= event.actorRole === "admin" ? "Admin" : "Student" %>
                  <%= event.action === "CREATED" ? "created this ticket" : event.action === "COMMENT_ADDED" ? "added a comment" : event.action === "STATUS_CHANGED" ? "changed status" : event.action === "PRIORITY_CHANGED" ? "changed priority" : event.action === "REOPENED" ? "reopened this ticket" : event.action === "RESOLUTION_CONFIRMED" ? "confirmed the resolution" : event.action === "FEEDBACK_SUBMITTED" ? "submitted feedback" : event.action === "ASSIGNED" ? "assigned this ticket" : event.action === "REASSIGNED" ? "reassigned this ticket" : event.action === "UNASSIGNED" ? "unassigned this ticket" : "updated this ticket" %>
                </p>
                <% if (event.details?.from && event.details?.to) { %>
                  <p class="text-gray-600 break-words"><%= event.details.from %> &rarr; <%= event.details.to %></p>
                <% } %>
                <% if (event.details?.reason) { %>
                  <p class="text-gray-600 whitespace-pre-wrap break-words"><%= event.details.reason %></p>
                <% } %>
                <% if (event.action === "FEEDBACK_SUBMITTED" && event.details) { %>
                  <p class="text-gray-600">Rating: <%= event.details.rating %> / 5<%= event.details.comment ? ` — ${event.details.comment}` : "" %></p>
                <% } %>
              </li>
            <% }) %>
          </ol>
        <% } %>
      </section>

      <section id="reply" class="bg-white rounded-xl shadow-sm p-5 sm:p-8">
        <h2 class="text-xl font-semibold mb-4">Reply</h2>
        <%- include('../partials/errors') %>
        <form action="<%= commentAction %>" method="POST" class="space-y-4">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="message" class="block text-sm font-medium text-gray-700">Message</label>
          <textarea id="message" name="message" rows="5" maxlength="2000" required class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" placeholder="Write a reply..."></textarea>
          <button type="submit" class="w-full sm:w-auto bg-indigo-600 text-white py-2 px-5 rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">Send Reply</button>
        </form>
      </section>
    </div>
  </main>
</body>
</html>
